# StaySeat - example environment file
# Copy to `.env` (in backend/) for docker compose, and provide the same
# JWT_SECRET + AUTH_DB_* values to the Auth Service (authservice/.env or
# real env vars) so tokens issued by Auth verify in the booking services.
#
#   cp backend/.env.example backend/.env

# --- Shared JWT signing secret -------------------------------------
# MUST be byte-for-byte identical across Auth, Hotel and Restaurant services,
# or every authenticated request fails with 401. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-shared-secret-at-least-32-bytes

# --- Auth Service database (container: auth-db, host port 5436) -----
# Published on 5436 because host 5433 is commonly taken by a local Postgres
# install. If you free 5433, set AUTH_DB_PORT=5433 (and the compose port).
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_svc
AUTH_DB_PASSWORD=auth_pass
# AUTH_DB_HOST=localhost
# AUTH_DB_PORT=5436

# --- Notification Service database (container: notification-db, 5435) ---
NOTIF_DB_USER=postgres
NOTIF_DB_PASSWORD=admin

# --- RabbitMQ (container: rabbitmq, host port 5672) -----------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- API Gateway ----------------------------------------------------
# Public entry point. Defaults to 8090 because 8080 is commonly occupied.
# GATEWAY_PORT=8090

# --- Optional per-service DB overrides ------------------------------
# The booking/notification services default to the compose host ports below;
# uncomment to point them elsewhere.
# HOTEL_DB_URL=jdbc:postgresql://localhost:5432/hotel_booking
# HOTEL_DB_USER=hotel_svc
# HOTEL_DB_PASSWORD=hotel_pass
# RESTAURANT_DB_URL=jdbc:postgresql://localhost:5434/restaurant_booking
# RESTAURANT_DB_USER=restaurant_svc
# RESTAURANT_DB_PASSWORD=restaurant_pass
# NOTIF_DB_URL=jdbc:postgresql://localhost:5435/notification_db
